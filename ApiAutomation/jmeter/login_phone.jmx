        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build encrypted login request">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonOutput
import javax.crypto.Cipher
import javax.crypto.spec.IvParameterSpec
import javax.crypto.spec.SecretKeySpec
import java.security.MessageDigest
import java.util.Base64

String encryptKey = vars.get('encryptKey')
String iv = 'O6xlNQ4e5oRTVZSu'

String phoneNumber = vars.get('phone_number')
if (phoneNumber == null || phoneNumber.trim().isEmpty()) {
    phoneNumber = vars.get('phone') ?: '15200711073'
}
phoneNumber = phoneNumber.trim()

String areaCode = vars.get('areaCode') ?: '86'
String verificationCode = vars.get('verificationCode') ?: '8888'
String plainPassword = vars.get('plainPassword') ?: 'a123456'
String encodedPassword = Base64.encoder.encodeToString(plainPassword.getBytes('UTF-8'))

def filterEmpty
filterEmpty = { obj ->
    if (obj instanceof Map) {
        def result = new LinkedHashMap()
        obj.each { key, value ->
            def cleaned = filterEmpty(value)
            if (cleaned != null && cleaned != '' && cleaned != [] && cleaned != [:]) {
                result[key] = cleaned
            }
        }
        return result
    }
    if (obj instanceof List) {
        return obj.collect { filterEmpty(it) }
            .findAll { it != null && it != '' && it != [] && it != [:] }
    }
    return obj
}

def transformSignKeys = { Map data ->
    def result = new LinkedHashMap()
    data.each { key, value ->
        String newKey
        if (key.startsWith('stay')) {
            newKey = key.substring(4)
            if (newKey) {
                newKey = newKey[0].toLowerCase() + newKey.substring(1)
            }
        } else {
            newKey = key ? key[0].toLowerCase() + key.substring(1) : key
        }
        result[newKey] = value
    }
    return result
}

def sha256 = { String text ->
    MessageDigest md = MessageDigest.getInstance('SHA-256')
    return md.digest(text.getBytes('UTF-8')).collect { String.format('%02x', it) }.join()
}

def aesEncrypt = { Map data ->
    String json = JsonOutput.toJson(filterEmpty(data))
    byte[] base64Json = Base64.encoder.encode(json.getBytes('UTF-8'))

    Cipher cipher = Cipher.getInstance('AES/CBC/PKCS5Padding')
    SecretKeySpec keySpec = new SecretKeySpec(encryptKey.getBytes('UTF-8'), 'AES')
    IvParameterSpec ivSpec = new IvParameterSpec(iv.getBytes('UTF-8'))
    cipher.init(Cipher.ENCRYPT_MODE, keySpec, ivSpec)

    return Base64.encoder.encodeToString(cipher.doFinal(base64Json))
}

def payload = new LinkedHashMap()
payload.platformType = 0
payload.appType = 0
payload.variantType = 0
payload.appVersion = '2.1.4'
payload.buildVersion = 317
payload.osModel = 'V2278A'
payload.osVersion = '13'
payload.language = 'en'
payload.uniqueId = 'bac1131e82cd4c738e3199375ffe77b4'
payload.uuid = '9fcd8047c27442138fdbdcddcb026ebd'
payload.deviceId = 'be825900787d419f9872eed48566f45c'
payload.widevineId = null
payload.idfv = null
payload.idfa = null
payload.mcc = null
payload.mnc = null
payload.networkName = null
payload.inviteCode = null
payload.downloadChannel = null
payload.ipAddress = '41.235.64.230'
payload.remoteIp = '41.235.64.230'
payload.timezone = 'Asia/Shanghai'
payload.tablet = 0
payload.simulator = 0
payload.useVpn = 0
payload.useRoot = 0
payload.useDebug = 0
payload.mockLocation = 0
payload.languageCountry = 'en'
payload.appLanguage = 'en'
payload.areaCode = areaCode
payload.phoneNumber = phoneNumber
payload.password = encodedPassword
payload.verificationCode = verificationCode
payload.captchaType = 0
payload.loginPwdType = 0

payload = filterEmpty(payload)

String locale = String.valueOf(payload.language ?: 'en')
String timestamp = String.valueOf(System.currentTimeMillis())
def signData = filterEmpty(transformSignKeys(payload))
String signSource = JsonOutput.toJson(signData)
String signString = "${signSource}&locale=${locale}&timestamp=${timestamp}${encryptKey}"
String sign = sha256(signString)
String encryptedBody = aesEncrypt(payload)

vars.put('phone_number', phoneNumber)
vars.put('locale', locale)
vars.put('timestamp', timestamp)
vars.put('sign', sign)
vars.put('encryptedBody', encryptedBody)
vars.put('plainPayload', JsonOutput.toJson(payload))
vars.put('signSource', signSource)
]]></stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert login success and extract credentials">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

String responseText = prev.getResponseDataAsString()
def response
try {
    response = new JsonSlurper().parseText(responseText)
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("响应不是 JSON: " + responseText)
    return
}

def codeOk = { value ->
    value in [0, '0', 200, '200']
}

boolean success = false
if (response instanceof Map) {
    success = codeOk(response.stayCode) ||
        response.stayIsSuccess == true ||
        codeOk(response.code) ||
        response.success == true ||
        response.status in ['success', 'ok', 'SUCCESS', 'OK']

    if (!success && response.data instanceof Map) {
        success = response.data.token || response.data.accessToken || response.data.jwt
    }

    def candidates = []
    if (response.stayResult instanceof Map) {
        candidates << response.stayResult
    }
    if (response.data instanceof Map) {
        candidates << response.data
    }
    candidates << response

    candidates.find { item ->
        if (item instanceof Map && item.stayUserId && item.stayToken) {
            vars.put('stayUserId', String.valueOf(item.stayUserId))
            vars.put('stayToken', String.valueOf(item.stayToken))
            return true
        }
        return false
    }
}

vars.put('loginSuccess', String.valueOf(success))

if (!success) {
    def message = response.stayErrorMessage ?: response.stayMessage ?: response.errorMessage ?: response.message ?: response.msg ?: response.error ?: '未知错误'
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("登录失败: phone=${vars.get('phone_number')}, message=${message}, response=${responseText}")
}
]]></stringProp>
          </JSR223Assertion>
          <hashTree/>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Pacing 2s">
            <stringProp name="ConstantTimer.delay">2000</stringProp>
          </ConstantTimer>
