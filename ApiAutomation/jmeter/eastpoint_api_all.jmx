          <stringProp name="script"><![CDATA[
import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import javax.crypto.Cipher
import javax.crypto.spec.IvParameterSpec
import javax.crypto.spec.SecretKeySpec
import java.security.MessageDigest
import java.util.Base64

def val = { String name, String fallback = '' ->
    String value = vars.get(name)
    if (value == null || value.length() == 0) {
        value = props.get(name)
    }
    return (value == null || value.length() == 0) ? fallback : value
}
def intVal = { String name, int fallback -> Integer.parseInt(val(name, String.valueOf(fallback))) }
def longVal = { String name, long fallback -> Long.parseLong(val(name, String.valueOf(fallback))) }
def normalizePath = { String path -> path.replace('\\', '/') }

String projectRoot = normalizePath(val('projectRoot', 'E:/python/work/ApiAutomation'))
String encryptKey = val('encryptKey', 'kGJGJBTNcPI3t0NnWWe60hOcKXuxpyo7')
String iv = 'O6xlNQ4e5oRTVZSu'
int iteration = Math.max(0, vars.getIteration() - 1)
int startIndex = intVal('startIndex', 0)
int rowIndex = startIndex + iteration

def readCsv = { String path ->
    File file = new File(normalizePath(path))
    if (!file.exists()) {
        return []
    }
    def lines = file.readLines('UTF-8')
    if (!lines) {
        return []
    }
    def headers = lines[0].replace('\uFEFF', '').split(',', -1).collect { it.trim() }
    return lines.drop(1).findAll { it.trim() }.collect { line ->
        def values = line.split(',', -1)
        def row = new LinkedHashMap()
        headers.eachWithIndex { header, index ->
            row[header] = index < values.size() ? values[index].trim() : ''
        }
        return row
    }
}

def csvValue = { String pathName, String column, String fallback ->
    def rows = readCsv(val(pathName, "${projectRoot}/data/${pathName}.csv"))
    if (!rows) {
        return fallback
    }
    return String.valueOf(rows[rowIndex % rows.size()][column] ?: fallback)
}

def deviceIdForRow = {
    String explicit = val('uniqueId', '')
    if (explicit) {
        return explicit
    }
    def rows = readCsv(val('deviceCsv', "${projectRoot}/data/device_ids.csv"))
    if (!rows) {
        return 'bac1131e82cd4c738e3199375ffe77b4'
    }
    return String.valueOf(rows[rowIndex % rows.size()].uniqueId ?: 'bac1131e82cd4c738e3199375ffe77b4')
}

def loadCredentials = {
    File batchFile = new File(normalizePath(val('batchCredentialsJson', "${projectRoot}/data/batch_login_credentials.json")))
    File singleFile = new File(normalizePath(val('credentialsJson', "${projectRoot}/data/login_credentials.json")))
    File file = batchFile.exists() ? batchFile : singleFile
    if (!file.exists()) {
        throw new IllegalStateException("登录凭证文件不存在: ${batchFile.path} 或 ${singleFile.path}")
    }
    def raw = new JsonSlurper().parse(file)
    def credentials = []
    raw.each { key, item ->
        credentials << [
            phone_number: String.valueOf(item.phone_number ?: key),
            stayUserId: String.valueOf(item.stayUserId ?: key),
            stayToken: String.valueOf(item.stayToken ?: ''),
            uniqueId: String.valueOf(item.uniqueId ?: '')
        ]
    }
    credentials = credentials.findAll { it.stayUserId && it.stayToken }
    if (!credentials) {
        throw new IllegalStateException("登录凭证为空或缺少 stayUserId/stayToken")
    }
    return credentials
}

def selectCredential = {
    String phone = val('phone', '')
    def credentials = loadCredentials()
    if (phone) {
        def found = credentials.find { it.phone_number == phone || it.stayUserId == phone }
        if (!found) {
            throw new IllegalStateException("未找到手机号或用户ID对应的登录凭证: ${phone}")
        }
        return found
    }
    return credentials[rowIndex % credentials.size()]
}

def b64 = { Object value ->
    value == null ? null : Base64.encoder.encodeToString(String.valueOf(value).getBytes('UTF-8'))
}

def parseList = { String text ->
    text.split(/[,\s]+/).findAll { it }.collect { item ->
        (item ==~ /-?\d+/) ? Long.parseLong(item) : item
    }
}

def filterEmpty
filterEmpty = { obj ->
    if (obj instanceof Map) {
        def result = new LinkedHashMap()
        obj.each { key, value ->
            def cleaned = filterEmpty(value)
            if (cleaned != null && cleaned != '' && cleaned != [] && cleaned != [:]) {
                result[key] = cleaned
            }
        }
        return result
    }
    if (obj instanceof List) {
        return obj.collect { filterEmpty(it) }.findAll { it != null && it != '' && it != [] && it != [:] }
    }
    return obj
}

def transformSignKeys = { Map data ->
    def result = new LinkedHashMap()
    data.each { key, value ->
        String newKey
        if (key.startsWith('stay')) {
            newKey = key.substring(4)
            if (newKey) {
                newKey = newKey[0].toLowerCase() + newKey.substring(1)
            }
        } else {
            newKey = key ? key[0].toLowerCase() + key.substring(1) : key
        }
        result[newKey] = value
    }
    return result
}

def sha256 = { String text ->
    MessageDigest md = MessageDigest.getInstance('SHA-256')
    return md.digest(text.getBytes('UTF-8')).collect { String.format('%02x', it) }.join()
}

def encryptPayload = { Map data ->
    String json = JsonOutput.toJson(filterEmpty(data))
    byte[] base64Json = Base64.encoder.encode(json.getBytes('UTF-8'))
    Cipher cipher = Cipher.getInstance('AES/CBC/PKCS5Padding')
    cipher.init(
        Cipher.ENCRYPT_MODE,
        new SecretKeySpec(encryptKey.getBytes('UTF-8'), 'AES'),
        new IvParameterSpec(iv.getBytes('UTF-8'))
    )
    return Base64.encoder.encodeToString(cipher.doFinal(base64Json))
}

def signAndStore = { Map payload, String localeValue ->
    def cleanPayload = filterEmpty(payload)
    String timestamp = String.valueOf(System.currentTimeMillis())
    String signSource = JsonOutput.toJson(filterEmpty(transformSignKeys(cleanPayload)))
    String sign = sha256("${signSource}&locale=${localeValue}&timestamp=${timestamp}${encryptKey}")
    vars.put('locale', localeValue)
    vars.put('timestamp', timestamp)
    vars.put('sign', sign)
    vars.put('encryptedBody', encryptPayload(cleanPayload))
    vars.put('plainPayload', JsonOutput.toJson(cleanPayload))
    vars.put('signSource', signSource)
}

def loginPayload = {
    String phone = val('phone', '') ?: csvValue('loginCsv', 'phone_number', '15200711073')
    String uniqueId = deviceIdForRow()
    vars.put('currentPhone', phone)
    vars.put('currentUniqueId', uniqueId)
    return [
        platformType: 0,
        appType: 0,
        variantType: 0,
        appVersion: '2.1.4',
        buildVersion: 317,
        osModel: 'V2278A',
        osVersion: '13',
        language: 'en',
        uniqueId: uniqueId,
        uuid: '9fcd8047c27442138fdbdcddcb026ebd',
        deviceId: 'be825900787d419f9872eed48566f45c',
        widevineId: null,
        idfv: null,
        idfa: null,
        mcc: null,
        mnc: null,
        networkName: null,
        inviteCode: null,
        downloadChannel: null,
        ipAddress: '41.235.64.230',
        remoteIp: '41.235.64.230',
        timezone: 'Asia/Shanghai',
        tablet: 0,
        simulator: 0,
        useVpn: 0,
        useRoot: 0,
        useDebug: 0,
        mockLocation: 0,
        languageCountry: 'en',
        appLanguage: 'en',
        areaCode: val('areaCode', '86'),
        phoneNumber: phone,
        password: b64(val('plainPassword', 'a123456')),
        verificationCode: val('verificationCode', '8888'),
        captchaType: 0,
        loginPwdType: 0
    ]
}

def registerData = {
    String phone = val('phone', '') ?: csvValue('registerCsv', 'phone_number', '13900011111')
    String uniqueId = deviceIdForRow()
    vars.put('currentPhone', phone)
    vars.put('currentUniqueId', uniqueId)
    return [phone: phone, uniqueId: uniqueId]
}

def credential = null
String sampleName = sampler.getName()
Map payload
String localeValue = 'en'
vars.put('token', '')

if (sampleName.contains('Login Phone')) {
    payload = loginPayload()
    localeValue = String.valueOf(payload.language ?: 'en')
} else if (sampleName.contains('Send Verification Code')) {
    def data = registerData()
    payload = [
        platformType: 0,
        appType: 0,
        variantType: 0,
        appVersion: '2.1.3',
        buildVersion: 317,
        osModel: 'RMX3511',
        osVersion: '33',
        language: 'ar',
        uniqueId: data.uniqueId,
        userSmsType: 0,
        areaCode: val('areaCode', '86'),
        phoneNumber: data.phone,
        validate: null,
        remoteIp: '41.235.64.230',
        ipAddress: '41.235.64.230'
    ]
    localeValue = String.valueOf(payload.language ?: 'ar')
} else if (sampleName.contains('Register User')) {
    String phone = vars.get('currentPhone') ?: (val('phone', '') ?: csvValue('registerCsv', 'phone_number', '13900011111'))
    String uniqueId = vars.get('currentUniqueId') ?: deviceIdForRow()
    payload = [
        platformType: 0,
        appType: 0,
        variantType: 0,
        appVersion: '2.1.3',
        buildVersion: 317,
        osModel: 'RMX3511',
        osVersion: '33',
        language: 'ar',
        uniqueId: uniqueId,
        adid: null,
        uuid: '9fcd8047c27442138fdbdcddcb026ebd',
        gaid: null,
        deviceId: 'be825900787d419f9872eed48566f45c',
        widevineId: null,
        idfv: null,
        idfa: null,
        tablet: 0,
        simulator: 0,
        useVpn: 0,
        vpnAddress: null,
        useRoot: 0,
        useDebug: 0,
        mockLocation: 0,
        timezone: 'Asia/Shanghai',
        languageCountry: 'CN',
        mcc: null,
        mnc: null,
        networkName: null,
        appLanguage: 'en',
        inviteCode: null,
        downloadChannel: null,
        ipAddress: '41.235.64.230',
        areaCode: val('areaCode', '86'),
        phoneNumber: phone,
        verificationCode: val('verificationCode', '8888')
    ]
    localeValue = String.valueOf(payload.language ?: 'ar')
} else if (sampleName.contains('Send Coin Red Packet')) {
    credential = selectCredential()
    vars.put('token', credential.stayToken)
    String roomId = val('roomId', '') ?: credential.stayUserId
    payload = [
        roomId: roomId,
        totalAmount: intVal('amount', 20000),
        totalCount: intVal('coinCount', 1),
        claimCondition: intVal('condition', 2),
        distributeType: intVal('distributeType', 1)
    ]
} else if (sampleName.contains('Send Gift Red Packet')) {
    credential = selectCredential()
    vars.put('token', credential.stayToken)
    String roomId = val('roomId', '') ?: credential.stayUserId
    payload = [
        roomId: roomId,
        giftId: intVal('giftId', 107),
        giftCount: intVal('giftCount', 7),
        totalAmount: intVal('totalAmount', 266),
        totalCount: intVal('totalCount', 5),
        claimCondition: intVal('condition', 2),
        distributeType: intVal('distributeType', 1)
    ]
} else if (sampleName.contains('Receive Red Packet')) {
    credential = selectCredential()
    vars.put('token', credential.stayToken)
    payload = [
        redPacketId: vars.get('extractedRedPacketId') ?: val('redPacketId', '1')
    ]
} else if (sampleName.contains('Batch Send Gift')) {
    credential = selectCredential()
    vars.put('token', credential.stayToken)
    payload = [
        recipients: parseList(val('recipients', '15712')),
        giftId: intVal('sendGiftId', 93),
        count: intVal('sendGiftCount', 10),
        sourceType: intVal('sourceType', 1),
        objectId: longVal('objectId', 202604290000000003L),
        roomId: val('roomId', '15712') ?: '15712'
    ]
} else if (sampleName.contains('Business Sample')) {
    credential = selectCredential()
    vars.put('token', credential.stayToken)
    payload = [
        userId: credential.stayUserId,
        phoneNumber: credential.phone_number,
        action: 'queryStatus'
    ]
} else {
    throw new IllegalStateException("未知 Sampler: ${sampleName}")
}

if (credential != null) {
    vars.put('currentPhone', credential.phone_number)
    vars.put('currentStayUserId', credential.stayUserId)
}
signAndStore(payload, localeValue)
]]></stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert EastPoint response success">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

String text = prev.getResponseDataAsString()
def response
try {
    response = new JsonSlurper().parseText(text)
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("响应不是 JSON: " + text)
    return
}

def codeOk = { value -> value in [0, '0', 200, '200'] }
boolean success = false
if (response instanceof Map) {
    success = codeOk(response.stayCode) ||
        response.stayIsSuccess == true ||
        codeOk(response.code) ||
        response.success == true ||
        response.status in ['success', 'ok', 'SUCCESS', 'OK']
    if (!success && response.data instanceof Map) {
        success = response.data.token || response.data.accessToken || response.data.jwt
    }
}
vars.put('apiSuccess', String.valueOf(success))

if (!success) {
    def message = response.stayErrorMessage ?: response.stayMessage ?: response.errorMessage ?: response.message ?: response.msg ?: response.error ?: '未知错误'
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("${prev.getSampleLabel()} 失败: phone=${vars.get('currentPhone')}, message=${message}, response=${text}")
}
]]></stringProp>
        </JSR223Assertion>
        <hashTree/>
        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract credentials and red packet id">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

def response
try {
    response = new JsonSlurper().parseText(prev.getResponseDataAsString())
} catch (Exception ignored) {
    return
}
if (!(response instanceof Map)) {
    return
}

def candidates = []
if (response.stayResult instanceof Map) {
    candidates << response.stayResult
}
if (response.data instanceof Map) {
    candidates << response.data
}
candidates << response

candidates.find { item ->
    if (item instanceof Map && item.stayUserId && item.stayToken) {
        vars.put('stayUserId', String.valueOf(item.stayUserId))
        vars.put('stayToken', String.valueOf(item.stayToken))
        return true
    }
    return false
}

candidates.find { item ->
    if (item instanceof Map && item.stayRedPacketId) {
        vars.put('extractedRedPacketId', String.valueOf(item.stayRedPacketId))
        return true
    }
    return false
}
]]></stringProp>
